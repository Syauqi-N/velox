# ============================================================
# Velox Environment Variables
# ============================================================
# For DOCKER / VPS:  use hostname "postgres" (the service name)
# For LOCAL DEV:     use localhost:5433
# ============================================================

# PostgreSQL connection string
# --- Docker/VPS (hostname = service name "postgres") ---
DATABASE_URL="postgresql://velox:velox_secret@postgres:5432/velox?schema=public"
# --- Local dev (uncomment if running outside Docker) ---
# DATABASE_URL="postgresql://velox:velox_secret@localhost:5433/velox?schema=public"

# Password for the postgres container (must match the user:pass in DATABASE_URL)
DB_PASSWORD="velox_secret"

# Next.js / NextAuth
# Set to your real domain in production, e.g. https://velox.example.com
NEXTAUTH_URL="http://localhost:3000"
# NextAuth v5 uses AUTH_SECRET (not NEXTAUTH_SECRET)
# Generate with:  openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret"

# Optional: admin email for seeding the first admin user
ADMIN_EMAIL="admin@veloxcapital.com"
# Required only while running `npx prisma db seed` (minimum 12 characters)
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# 9Router endpoint for TRISTA AI
NINEROUTER_URL="http://100.90.253.13:20128/v1"
NINEROUTER_KEY="sk-your-9router-api-key"
